# Copy to .env.local and fill in. All values except GMAIL_QUERY are required.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Any long random string, e.g. output of: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# The client needs redirect URI http://localhost:3000/api/auth/callback/google
# and the Gmail API enabled on the project.
GOOGLE_ID=
GOOGLE_SECRET=
GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/gmail.readonly

# OpenAI
OPENAI_API_KEY=

# Optional: Gmail search query for which emails to analyze.
# Defaults to newer_than:30d. Example: label:feedback newer_than:90d
# GMAIL_QUERY=
